# Aster & Row AI Support Agent Configuration
# Copy this file to .env and configure your environment

# LLM Provider API Keys
OPENAI_API_KEY=your-openai-api-key-here
# Optional base URL if using a proxy / compatible endpoint (e.g., Azure OpenAI, LiteLLM, Ollama)
OPENAI_BASE_URL=

# Model Configuration
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Data Paths (relative to project root or absolute)
ORDERS_DATA_PATH=data/orders.json
KNOWLEDGE_BASE_DIR=knowledge-base

# Operational Settings
LOG_LEVEL=INFO
DEBUG=false
